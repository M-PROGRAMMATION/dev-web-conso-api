{
    "swagger": "2.0",
    "info": {
        "description": "API REST en Go développée dans le cadre du cours Développement Web / Consommation d'API (YNOV).",
        "title": "Dev Web Conso API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "default"
                ],
                "summary": "Healthcheck simple",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/artists": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "artists"
                ],
                "summary": "Liste des artistes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/objects.Artist"
                            }
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/artists/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "artists"
                ],
                "summary": "Récupère un artiste par son id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de l'artiste",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/objects.Artist"
                        }
                    },
                    "400": {
                        "description": "id invalide",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "artiste introuvable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Retourne l'heure de démarrage et l'uptime du serveur",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "default"
                ],
                "summary": "Statut du serveur",
                "responses": {
                    "200": {
                        "description": "Health: OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/relation": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "relation"
                ],
                "summary": "Liste de toutes les relations (dates/lieux)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/objects.RelationIndex"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/relation/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "relation"
                ],
                "summary": "Récupère une relation par son id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la relation",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/objects.Relation"
                        }
                    },
                    "400": {
                        "description": "id invalide",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "relation introuvable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "objects.Artist": {
            "type": "object",
            "properties": {
                "creationDate": {
                    "type": "integer"
                },
                "firstAlbum": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "members": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "objects.Relation": {
            "type": "object",
            "properties": {
                "datesLocations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "id": {
                    "type": "integer"
                }
            }
        },
        "objects.RelationIndex": {
            "type": "object",
            "properties": {
                "index": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/objects.Relation"
                    }
                }
            }
        }
    }
}