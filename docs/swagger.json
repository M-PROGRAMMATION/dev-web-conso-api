{
    "swagger": "2.0",
    "info": {
        "description": "API REST en Go développée dans le cadre du cours Développement Web / Consommation d'API (YNOV).",
        "title": "Dev Web Conso API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Affiche la liste des artistes avec une barre de recherche",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "default"
                ],
                "summary": "Page d'accueil",
                "responses": {
                    "200": {
                        "description": "page HTML",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/events": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "events"
                ],
                "summary": "Liste des concerts, triés par date et filtrables par ville / intervalle de dates",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filtre par ville",
                        "name": "city",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Date de début (AAAA-MM-JJ)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Date de fin (AAAA-MM-JJ)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/objects.Event"
                            }
                        }
                    },
                    "400": {
                        "description": "paramètre invalide",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/stats": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stats"
                ],
                "summary": "Statistiques globales (nombre d'artistes, de concerts, répartition par ville)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/objects.Stats"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/artist/{id}": {
            "get": {
                "description": "Affiche les informations d'un artiste et la liste de ses concerts",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "default"
                ],
                "summary": "Page détaillée d'un artiste",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de l'artiste",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "page HTML",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "artiste introuvable",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/artists": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "artists"
                ],
                "summary": "Liste des artistes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/objects.Artist"
                            }
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/artists/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "artists"
                ],
                "summary": "Récupère un artiste par son id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de l'artiste",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/objects.Artist"
                        }
                    },
                    "400": {
                        "description": "id invalide",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "artiste introuvable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/concerts": {
            "get": {
                "description": "Affiche tous les concerts, triés par date, filtrables par ville et intervalle de dates",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "default"
                ],
                "summary": "Liste des concerts",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filtre par ville",
                        "name": "city",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Date de début (AAAA-MM-JJ)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Date de fin (AAAA-MM-JJ)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "page HTML",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Retourne l'heure de démarrage et l'uptime du serveur",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "default"
                ],
                "summary": "Statut du serveur",
                "responses": {
                    "200": {
                        "description": "Health: OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/relation": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "relation"
                ],
                "summary": "Liste de toutes les relations (dates/lieux)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/objects.RelationIndex"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/relation/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "relation"
                ],
                "summary": "Récupère une relation par son id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la relation",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/objects.Relation"
                        }
                    },
                    "400": {
                        "description": "id invalide",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "relation introuvable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "erreur serveur",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "objects.Artist": {
            "type": "object",
            "properties": {
                "creationDate": {
                    "type": "integer"
                },
                "firstAlbum": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "members": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "objects.Event": {
            "type": "object",
            "properties": {
                "artistId": {
                    "type": "integer"
                },
                "artistName": {
                    "type": "string"
                },
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "date": {
                    "type": "string"
                }
            }
        },
        "objects.Relation": {
            "type": "object",
            "properties": {
                "datesLocations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "id": {
                    "type": "integer"
                }
            }
        },
        "objects.RelationIndex": {
            "type": "object",
            "properties": {
                "index": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/objects.Relation"
                    }
                }
            }
        },
        "objects.Stats": {
            "type": "object",
            "properties": {
                "eventsByCity": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    }
                },
                "totalArtists": {
                    "type": "integer"
                },
                "totalEvents": {
                    "type": "integer"
                }
            }
        }
    }
}